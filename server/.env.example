# ── HISENSE LingxiBI — server configuration ──
# Copy this file to `.env` and fill in real values. Never commit your `.env`.

# MySQL / MariaDB connection for the platform's metadata database.
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Note: URL-encode special characters in the password (e.g. '@' -> %40).
DATABASE_URL=mysql://ai_report:change-me@127.0.0.1:3306/ai_report

# Secret used to sign JWT auth tokens. MUST be at least 16 characters.
# Generate a strong random value, e.g.:  openssl rand -hex 32
# Leave this placeholder in place and anyone can forge an admin token.
JWT_SECRET=

# Key used to encrypt stored credentials at rest (data-source passwords, the
# LLM API key, SMTP password, Feishu secret) with AES-256-GCM. Optional: if
# unset, the key is derived from JWT_SECRET, which means one leaked value both
# forges admin tokens AND decrypts every stored credential — and rotating
# JWT_SECRET to revoke sessions would make those credentials unreadable. Set a
# dedicated value in production:  openssl rand -hex 32
# Must be >= 32 characters and different from JWT_SECRET (enforced at startup).
# WARNING: changing this (or JWT_SECRET when this is unset) invalidates
# previously stored secrets — they must be re-entered.
ENCRYPTION_KEY=

# CORS allowed origin. Use "*" for local development, or your site origin
# (e.g. https://example.com) in production. Optional; defaults to "*".
CORS_ALLOWED_ORIGIN=*

# ── GitHub OAuth (optional) ──
# Leave GITHUB_CLIENT_ID/SECRET unset to disable GitHub sign-in entirely.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Who may sign in with GitHub. By default only accounts that ALREADY exist in
# this instance can log in — otherwise any GitHub account on the internet would
# get a `member` account, bypassing "registration disabled".
# Exception: on a brand-new instance with zero users, the first GitHub sign-in
# becomes the admin so the instance can be set up.
#
# Comma-separated allowlist of GitHub logins permitted to self-register:
GITHUB_ALLOWED_LOGINS=
# Or set to true to allow ANY GitHub account to self-register (not recommended
# on an internet-facing instance):
GITHUB_ALLOW_SIGNUP=false

# ── Data source credentials ──
# Data sources are added at runtime in the UI, not here. Give each one a
# READ-ONLY database account (e.g. MySQL: GRANT SELECT ON db.* TO 'bi_ro'@'%').
# The SQL validator blocks writes by inspecting statement text, which is a
# best-effort layer — database-level least privilege is what actually guarantees
# a query can't modify or exfiltrate data.

# The LLM provider (OpenAI-compatible / DeepSeek), API key, model, etc. are
# configured at runtime in the app's Settings page and stored in the database,
# so they do not need to be set here.
